# Sunucu portu
PORT=5000

# JWT imzalama anahtarı — üretimde mutlaka uzun/rastgele bir değerle değiştirin
JWT_SECRET=change-this-to-a-long-random-string

# İlk kurulumda otomatik oluşturulacak yönetici hesabı
# (veritabanında zaten bir admin varsa bu değerler dikkate alınmaz)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Randevu onay/hatırlatma e-postaları için Gmail SMTP bilgileri.
# Boş bırakılırsa e-posta gönderimi otomatik olarak devre dışı kalır (hata vermez).
# Kurulum: Google Hesabı > Güvenlik > 2 Adımlı Doğrulama açık olmalı,
# ardından "Uygulama Şifreleri" (App Passwords) ile 16 haneli bir şifre oluşturun.
# Normal Gmail şifreniz DEĞİL, bu uygulama şifresini kullanın.
SMTP_USER=isletmeniz@gmail.com
SMTP_PASS=uygulama-sifresi-16-hane
SMTP_FROM_NAME=İşletmeniz
